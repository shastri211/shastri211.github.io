---
import { site } from '@/data/site';
import { hasResume } from '@/lib/resume';
import Icon from './ui/Icon.astro';

const built = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date());
---

<footer class="site-footer" id="contact">
  <div class="wrap grid">
    <div class="col-rail intro">
      <p class="label label--caps">Contact</p>
    </div>
    <div class="col-main">
      <p class="lede">
        If something here is relevant to what you are building or hiring for, write to me.
      </p>
      <p class="email">
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <ul class="links label">
        <li>
          <a href={site.links.github} rel="me noopener">
            GitHub <Icon name="arrow-up-right" size={11} />
          </a>
        </li>
        <li>
          <a href={site.links.linkedin} rel="me noopener">
            LinkedIn <Icon name="arrow-up-right" size={11} />
          </a>
        </li>
        {hasResume && (
          <li>
            <a href={site.links.resume}>
              Resume (PDF) <Icon name="download" size={11} />
            </a>
          </li>
        )}
      </ul>
    </div>

    <p class="fine label col-wide">
      <span>
        © {new Date().getUTCFullYear()} {site.name}
      </span>
      <span>Updated {built}</span>
      <span>
        Built with Astro.{' '}
        <a href={site.links.source} rel="noopener">
          Source
        </a>
        .
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    padding-block: var(--s-7) var(--s-6);
    border-top: 1px solid var(--rule-strong);
  }

  .intro {
    padding-bottom: var(--s-4);
  }

  .lede {
    max-width: 34ch;
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--ink-2);
  }

  .email {
    margin-top: var(--s-4);
    font-size: var(--step-3);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-5);
  }

  .fine {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
    margin-top: var(--s-8);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }
</style>
