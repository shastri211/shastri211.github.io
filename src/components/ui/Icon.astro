---
/** The few glyphs the site needs. Inline so there is no icon font or package to load. */
interface Props {
  name: 'arrow-right' | 'arrow-up-right' | 'download' | 'theme';
  size?: number;
  class?: string;
}

const { name, size = 14, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M2 8h11M9 3.5 13.5 8 9 12.5" />}
  {name === 'arrow-up-right' && <path d="M4.5 11.5l7-7M5.5 4.5h6v6" />}
  {name === 'download' && <path d="M8 2v8.5M4.5 7 8 10.5 11.5 7M3 13.5h10" />}
  {name === 'theme' && (
    <>
      <circle cx="8" cy="8" r="5.5" />
      <path d="M8 2.5v11a5.5 5.5 0 0 0 0-11Z" fill="currentColor" stroke="none" />
    </>
  )}
</svg>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: -0.12em;
  }
</style>
